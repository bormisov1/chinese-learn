{
  "expo": {
    "name": "Hanzi Deck",
    "slug": "hanzi-deck",
    "scheme": "hanzideck",
    "version": "1.0.0",
    "icon": "./assets/icon.png",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.bormisov.hanzideck",
      "newArchEnabled": false,
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.bormisov.hanzideck",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon-foreground.png",
        "backgroundColor": "#F7C07C"
      },
      "permissions": []
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose vocabulary screenshots to import.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-font",
      [
        "expo-build-properties",
        {
          "ios": { "deploymentTarget": "15.5" }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "backgroundColor": "#F7F5EE",
          "imageWidth": 180
        }
      ]
    ],
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e1f3bc6b-2f84-4b20-8b1a-3511c1341559"
      }
    }
  }
}
