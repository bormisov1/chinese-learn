{
  "name": "hanzi-deck",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "web": "expo start --web",
    "build:web": "expo export --platform web",
    "build:hsk-data": "node scripts/build-hsk-levels.mjs && node scripts/build-russian-dictionary.mjs && node scripts/build-english-dictionary.mjs && node scripts/validate-hsk-data.mjs",
    "build:hsk-levels": "node scripts/build-hsk-levels.mjs",
    "build:dictionary": "node scripts/build-english-dictionary.mjs",
    "build:dictionary:ru": "node scripts/build-russian-dictionary.mjs",
    "validate:hsk-data": "node scripts/validate-hsk-data.mjs",
    "test": "tsx --test src/*.test.ts",
    "serve:web": "serve -s dist -l tcp://0.0.0.0:8081",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~54.0.30",
    "expo-router": "~6.0.21",
    "expo-status-bar": "~3.0.9",
    "opencc-js": "^1.4.2",
    "pako": "^3.0.1",
    "qrcode": "^1.5.4",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-web": "~0.21.0"
  },
  "devDependencies": {
    "@types/pako": "^2.0.4",
    "@types/qrcode": "^1.5.6",
    "@types/react": "~19.1.10",
    "serve": "^14.2.5",
    "tsx": "^4.23.13",
    "typescript": "~5.9.2"
  }
}
